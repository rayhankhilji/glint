{
  "$comment": "Single source of truth for Saccade colors (DESIGN_SYSTEM §2): pure monochrome. Compiled to Swift by scripts/design/build_tokens.py; contrast verified by scripts/contrast.py.",
  "chrome": {
    "background":    { "light": "#FFFFFF",      "dark": "#0A0A0A",      "use": "Window background" },
    "surface":       { "light": "#FFFFFF",      "dark": "#141414",      "use": "Raised surfaces: cards, sheets" },
    "subtle":        { "light": "#F4F4F5",      "dark": "#1C1C1E",      "use": "Row hover, inline callouts" },
    "border":        { "light": "#0A0A0A14",    "dark": "#FFFFFF17",    "use": "Hairlines (alpha in the last two hex digits)" },
    "text":          { "light": "#0A0A0A",      "dark": "#FAFAFA",      "use": "Primary text" },
    "textMuted":     { "light": "#636366",      "dark": "#8E8E93",      "use": "Secondary text and icons" },
    "textFaint":     { "light": "#A1A1A6",      "dark": "#5A5A5F",      "use": "Shortcuts, placeholders (non-essential text only)" },
    "accent":        { "light": "#0A0A0A",      "dark": "#FAFAFA",      "use": "Primary buttons, switch: ink on paper, paper on ink" },
    "onAccent":      { "light": "#FFFFFF",      "dark": "#0A0A0A",      "use": "Text on accent" },
    "accentSoft":    { "light": "#0A0A0A0F",    "dark": "#FAFAFA14",    "use": "Selected rows" },
    "success":       { "light": "#1F7A45",      "dark": "#5BC98A",      "use": "Tracking, good accuracy" },
    "warning":       { "light": "#94600A",      "dark": "#E9A949",      "use": "Paused, fair accuracy, low light" },
    "danger":        { "light": "#C0362C",      "dark": "#FF6F61",      "use": "Blocked, poor accuracy" },
    "focusRing":     { "light": "#0A0A0A",      "dark": "#FAFAFA",      "use": "Keyboard focus" },
    "scrim":         { "light": "#00000059",    "dark": "#0000008C",    "use": "Calibration backdrop" }
  },
  "overlay": {
    "ink":           { "value": "#000000",      "use": "Core stroke of every overlay mark (reads on light content)" },
    "paper":         { "value": "#FFFFFF",      "use": "Halo stroke around the core (reads on dark content)" },
    "inkFill":       { "value": "#00000012",    "use": "Locked target fill, 7%" },
    "inkFillArmed":  { "value": "#00000021",    "use": "Armed target fill, 13%" },
    "paperFlash":    { "value": "#FFFFFF73",    "use": "Click flash, 45% paper over the target" },
    "uncertain":     { "value": "#00000073",    "use": "Candidate outlines when two targets tie, 45%" },
    "lineHighlight": { "value": "#0000001A",    "use": "Where-was-I line band, 10%" },
    "debugDot":      { "value": "#FF3B6BCC",    "use": "Debug gaze dot (Advanced only)" }
  },
  "contrast": [
    ["text", "background", 4.5], ["textMuted", "background", 4.5], ["text", "surface", 4.5], ["textMuted", "surface", 4.5],
    ["onAccent", "accent", 4.5], ["success", "background", 4.5], ["warning", "background", 4.5], ["danger", "background", 4.5],
    ["focusRing", "background", 3.0], ["textMuted", "subtle", 4.5]
  ]
}
