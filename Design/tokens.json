{
  "$comment": "Single source of truth for Saccade colors (DESIGN_SYSTEM §2). Compiled to Swift by scripts/design/build_tokens.py; contrast verified by scripts/contrast.py.",
  "chrome": {
    "background":    { "light": "#FBFBFC",      "dark": "#0B0C0D",      "use": "Window background" },
    "surface":       { "light": "#FFFFFF",      "dark": "#141516",      "use": "Raised surfaces: banners, sheets, cards" },
    "subtle":        { "light": "#F3F4F6",      "dark": "#1B1C1E",      "use": "Hover rows, inset fields" },
    "border":        { "light": "#0F10110F",    "dark": "#FFFFFF14",    "use": "Hairlines (alpha in the last two hex digits)" },
    "text":          { "light": "#0F1011",      "dark": "#EDEEF0",      "use": "Primary text" },
    "textMuted":     { "light": "#6B6F76",      "dark": "#8A8F98",      "use": "Secondary text and icons" },
    "textFaint":     { "light": "#9A9DA3",      "dark": "#5E636B",      "use": "Shortcuts, placeholders (non-essential text only)" },
    "accent":        { "light": "#5753D9",      "dark": "#8B8DF8",      "use": "Primary buttons, switch, links, selection, the mark's catchlight" },
    "onAccent":      { "light": "#FFFFFF",      "dark": "#0B0C0D",      "use": "Text on accent" },
    "accentSoft":    { "light": "#5753D91A",    "dark": "#8B8DF81F",    "use": "Selected rows, accent-tinted fills" },
    "success":       { "light": "#16794A",      "dark": "#4CC38A",      "use": "Good accuracy, granted" },
    "warning":       { "light": "#9A5B00",      "dark": "#F1A33C",      "use": "Fair accuracy, low light" },
    "danger":        { "light": "#C42B1C",      "dark": "#FF6B5E",      "use": "Denied, poor accuracy, destructive" },
    "focusRing":     { "light": "#5753D9",      "dark": "#8B8DF8",      "use": "Keyboard focus" },
    "scrim":         { "light": "#00000059",    "dark": "#0000008C",    "use": "Calibration backdrop" }
  },
  "overlay": {
    "ring":          { "value": "#6366F1",      "use": "Target highlight ring, 1.5 pt (4.5:1 on white, 4.7:1 on black)" },
    "ringArmed":     { "value": "#6366F1",      "use": "Armed ring, 2 pt" },
    "fill":          { "value": "#6366F114",    "use": "Target highlight fill, 8%" },
    "fillArmed":     { "value": "#6366F124",    "use": "Armed fill, 14%" },
    "fillPress":     { "value": "#6366F13D",    "use": "Click flash fill, 24%" },
    "hairline":      { "value": "#FFFFFFB3",    "use": "1 pt inner hairline so the ring separates from dark accent-colored UI" },
    "uncertain":     { "value": "#6366F173",    "use": "Two candidate rings, 1 pt, 45%" },
    "progress":      { "value": "#6366F1",      "use": "Scroll-dwell progress bar, 2 pt" },
    "lineHighlight": { "value": "#6366F12E",    "use": "Where-was-I line highlight, 18%" },
    "debugDot":      { "value": "#FF3B6BCC",    "use": "Debug gaze dot (Advanced only)" }
  },
  "contrast": [
    ["text", "background", 4.5], ["textMuted", "background", 4.5], ["text", "surface", 4.5], ["textMuted", "surface", 4.5],
    ["accent", "background", 4.5], ["accent", "surface", 4.5], ["onAccent", "accent", 4.5],
    ["success", "background", 4.5], ["warning", "background", 4.5], ["danger", "background", 4.5],
    ["focusRing", "background", 3.0], ["focusRing", "surface", 3.0], ["textMuted", "subtle", 4.5]
  ]
}
